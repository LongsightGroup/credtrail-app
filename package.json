{
  "name": "credtrail",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.2+sha512.bef43fa759d91fd2da4b319a5a0d13ef7a45bb985a3d7342058470f9d2051a3ba8674e629672654686ef9443ad13a82da2beb9eeb3e0221c87b8154fff9d74b8",
  "scripts": {
    "build:design-tokens": "style-dictionary build --config style-dictionary.config.mjs && node scripts/wrap-design-tokens.mjs",
    "check:design-tokens": "pnpm build:design-tokens && git diff --exit-code -- apps/api-worker/src/ui/page-assets/content/generated/design-tokens.css apps/api-worker/src/ui/page-assets/content/generated/design-tokens-css.ts",
    "export:ob3-openapi": "pnpm exec tsx scripts/export-ob3-openapi.mjs",
    "check:ob3-openapi": "pnpm exec tsx scripts/check-ob3-openapi.mjs",
    "db:migrate:postgres": "node packages/db/scripts/migrate-postgres.mjs",
    "dev": "pnpm exec wrangler dev --config wrangler.local.jsonc --env-file .dev.vars.local --port 8787",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:down": "node scripts/dev-down.mjs",
    "dev:reset": "node scripts/dev-reset.mjs && pnpm dev:seed",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:seed": "pnpm exec tsx scripts/seed-local-dev.ts",
    "dev:login-as": "node scripts/create-local-login-url.mjs",
    "dev:demo": "node scripts/run-local-demo.mjs",
    "test:e2e": "pnpm exec playwright test --config playwright.config.mjs --project chromium",
    "lint": "node scripts/run-oxlint.mjs --deny-warnings",
    "lint:fix": "node scripts/run-oxlint.mjs --fix --fix-suggestions --deny-warnings",
    "format": "pnpm exec oxfmt \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/*.ts\" \"packages/**/*.tsx\" \"vitest.config.ts\"",
    "format:check": "pnpm exec oxfmt --check \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/*.ts\" \"packages/**/*.tsx\" \"vitest.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "pnpm check:design-tokens && pnpm check:ob3-openapi && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:scripts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260604.1",
    "@playwright/test": "^1.60.0",
    "@sphereon/oid4vci-client": "^0.20.1",
    "@types/jsonld": "^1.5.15",
    "@types/pg": "^8.20.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "style-dictionary": "^5.4.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "better-auth": "1.6.14"
  },
  "pnpm": {
    "overrides": {
      "jose": "6.2.3",
      "zod": "4.4.3"
    }
  }
}
